PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/lifeline
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Optional. Without it, ETA/distance fall back to a straight-line estimate.
GOOGLE_MAPS_API_KEY=

# Real SMS Gateway (Pick one to receive real SMS OTP on phones)
# Option 1: Fast2SMS (India) - https://fast2sms.com
FAST2SMS_API_KEY=
# Option 2: 2Factor (India) - https://2factor.in
TWOFACTOR_API_KEY=
# Option 3: Twilio (Global) - https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
